# Required: Databricks PostgreSQL URL for the recallgraph database.
# URL-encode any reserved characters in the username or password.
DATABRICKS_DATABASE_URL=postgresql://<username>:<password>@<endpoint-host>:5432/recallgraph?sslmode=require

# Local Redis broker for the API and Celery worker.
REDIS_URL=redis://localhost:6379/0

# Optional local append-only worker error log path.
WORKER_ERROR_LOG=worker-errors.log

# Optional: use a harmless mock extractor to verify the worker pipeline.
# It logs capture_id and does not persist extraction output.
WORKER_EXTRACTION_MODE=live

# Optional fallback when DATABRICKS_DATABASE_URL is not set.
# DATABASE_URL=postgresql://<username>:<password>@<endpoint-host>:5432/recallgraph?sslmode=require

# Optional SQLAlchemy SQL logging.
SQLALCHEMY_ECHO=false

# Optional: disable asyncpg's prepared statement cache if required by the proxy.
DB_DISABLE_PREPARED_STATEMENTS=false
