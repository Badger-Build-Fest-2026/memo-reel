{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug FastAPI (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "APP_ENV": "development",
        "LOG_LEVEL": "debug"
      },
      "jinja": true
    }
  ]
}
